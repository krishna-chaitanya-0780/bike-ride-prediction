# Default uses SQLite inside ./data — no cloud account required.
# DATABASE_URL=postgresql+psycopg://REPLACE_WITH_SECURE_MANAGED_DATABASE_URL
COOKIE_SECURE=0
# Only set COOKIE_SECURE=1 after HTTPS proxy is configured.

# Owner review token: generate with python -c "import secrets;print(secrets.token_urlsafe(48))"
# Set only on trusted backend; NEVER expose to web JS or commit real values.
# VERDANT_OWNER_TOKEN=<at-least-28-random-chars>

# Razorpay TEST mode only. Live key IDs are deliberately rejected by application code.
ENABLE_TEST_CHECKOUT=0
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_TEST_WEBHOOK_SECRET=...

# Shiprocket read-only rates: disabled until credentials + approval.
ENABLE_SHIPROCKET_QUOTES=0
# SHIPROCKET_API_TOKEN=...
